<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: lets iOS hand cortexcases.com/case/… straight to the
	     app when it's installed. Requires the apple-app-site-association file
	     served from the site (see web/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cortexcases.com</string>
		<string>applinks:www.cortexcases.com</string>
	</array>
</dict>
</plist>
